
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  TEACHER
  STUDENT
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

model User {
  id                String          @id @default(cuid()) @db.VarChar(30)
  auth0Id           String          @unique @map("auth0_id") @db.VarChar(191)
  email             String          @unique @db.VarChar(191)
  firstName         String          @map("first_name") @db.VarChar(100)
  lastName          String          @map("last_name") @db.VarChar(100)
  phone             String?         @db.VarChar(30)
  role              UserRole
  subject           String?         @db.VarChar(100)
  isActive          Boolean         @default(true) @map("is_active")
  classId           String?         @map("class_id") @db.VarChar(30)
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  class             Class?          @relation(fields: [classId], references: [id], onDelete: SetNull)
  teacherClasses    ClassTeacher[]
  attendance        Attendance[]    @relation("AttendanceForStudent")
  attendanceMarked  Attendance[]    @relation("AttendanceMarkedBy")
  attendanceChanges Attendance[]    @relation("AttendanceLatestChangedBy")

  @@index([role])
  @@index([classId])
  @@map("users")
}

model Class {
  id           String          @id @default(cuid()) @db.VarChar(30)
  name         String          @unique @db.VarChar(120)
  code         String          @unique @db.VarChar(30)
  description  String?         @db.Text
  academicYear String?         @map("academic_year") @db.VarChar(20)
  isActive     Boolean         @default(true) @map("is_active")
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")

  students     User[]
  teachers     ClassTeacher[]
  attendance   Attendance[]

  @@map("classes")
}

model ClassTeacher {
  teacherId String   @map("teacher_id") @db.VarChar(30)
  classId   String   @map("class_id") @db.VarChar(30)
  assignedAt DateTime @default(now()) @map("assigned_at")

  teacher   User     @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@id([teacherId, classId])
  @@index([classId])
  @@map("class_teachers")
}

model Attendance {
  id                String           @id @default(cuid()) @db.VarChar(30)
  studentId         String           @map("student_id") @db.VarChar(30)
  classId           String           @map("class_id") @db.VarChar(30)
  date              DateTime         @db.Date
  status            AttendanceStatus
  remarks           String?          @db.VarChar(500)
  markedById        String           @map("marked_by_id") @db.VarChar(30)
  latestChangedById String?          @map("latest_changed_by_id") @db.VarChar(30)
  latestChangedAt   DateTime?        @map("latest_changed_at")
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt

  student           User             @relation("AttendanceForStudent", fields: [studentId], references: [id], onDelete: Cascade)
  class             Class            @relation(fields: [classId], references: [id], onDelete: Cascade)
  markedBy          User             @relation("AttendanceMarkedBy", fields: [markedById], references: [id], onDelete: Restrict)
  latestChangedBy   User?            @relation("AttendanceLatestChangedBy", fields: [latestChangedById], references: [id], onDelete: SetNull)

  @@unique([studentId, date])
  @@index([classId, date])
  @@index([studentId, date])
  @@map("attendance")
}

model SystemSetting {
  id        String   @id @default(cuid()) @db.VarChar(30)
  key       String   @unique @db.VarChar(100)
  value     String   @db.Text
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}
